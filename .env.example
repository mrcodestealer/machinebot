# ================= Maintenance-agent LLM intent parsing (optional; regex fallback without it) =================
BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
BOT_CHAT_API_KEY=<your-value-here>
BOT_CHAT_MODEL=qwen3.6:35b-a3b
# BOT_MAINT_AGENT_LLM=  (not set in osedutybot/.env)
# BOT_MAINT_AGENT_MODEL=  (not set in osedutybot/.env)
# BOT_MAINT_AGENT_LLM_TIMEOUT=  (not set in osedutybot/.env)
# MAINT_DIRECT_SET_UNSET_MAX=  (not set in osedutybot/.env)

# ================= Credit / log flows (mirrored from log&creditbot) =================
# OSS HTTP is the default checkcredit log source; CHECKCREDIT_USE_OSS=0 forces LogNavigator.
CHECKCREDIT_USE_OSS=1
# Jackpot hint: after the /checkcredit player card, the EGM operation-window screenshot is shown
# to the local vision model; when it reads a jackpot-sized WIN the bot replies in the same thread
# with "It seems hit jackpot. Kindly check.". Uses the chatagent LLM settings above
# (BOT_CHAT_API_BASE / BOT_CHAT_API_KEY / BOT_CHAT_MODEL) unless overridden here. The model must
# be vision-capable: `ollama show <model>` has to list `vision`.
#
# PIN THE VISION MODEL. BOT_CHAT_MODEL above is text-only, so without this the code picks the
# first vision model `ollama list` happens to return — whichever that is on the day, silently.
BOT_CHAT_VISION_MODEL=qwen2.5vl:3b
# CHECKCREDIT_JACKPOT_VISION=0        # turn the check off (default: on)
# CHECKCREDIT_JACKPOT_MODEL=qwen2.5vl:3b   # overrides BOT_CHAT_VISION_MODEL for this check only
# CHECKCREDIT_JACKPOT_TIMEOUT=180     # seconds to wait for the model
# A positive verdict is checked against the counters the model itself read: a WIN below this
# multiple of the BET is not a jackpot however sure the model sounds, and is suppressed (the
# reason is logged as "[jackpot] … suppressed"). 0 disables the check and trusts the model alone.
# CHECKCREDIT_JACKPOT_MIN_BET_MULTIPLE=100
# The model must accept images. Ollama answers HTTP 400 "Multimodal data provided, but model does
# not support multimodal requests" otherwise; check with `ollama show <model>` (it has to list
# `vision`). When the configured model cannot, an installed vision model is used instead —
# arbitrary, so pin BOT_CHAT_VISION_MODEL above rather than relying on it:
# CHECKCREDIT_VISION_FALLBACK=0        # …unless you turn that off and want the plain error
# A recharge Detail for a cash-out has a POSITIVE Request `amount`; a negative one is credit going
# into the cabinet, so it is the wrong record and the scan moves on to the next recharge row.
# NP_BACKEND_REQUIRE_POSITIVE_AMOUNT=0   # accept either sign again (pre-2026-09 behaviour)
# /url matches the Detail amount against the credit as read, plus its doubled and halved forms.
# Those two are derived, and the cabinet's denomination rounds them (1009 halved is 504.5, booked
# as 504 or 505), so they match a +-1 band rather than an exact value.
# NP_BACKEND_SCALED_TOLERANCE=1          # widen/narrow that band (0 = exact)
# The EGM operation-window screenshot (/checkcredit preview, /url credit read) needs a TALL
# viewport: Element UI sizes the modal body off 100vh, so a short one cuts the game screen in
# half. Defaults 1680x2400, floored at 1280x1200. (/cctvshot has its own CCTV_EGM_VIEWPORT_*.)
# EGM_STATUS_VIEWPORT_WIDTH=1680
# EGM_STATUS_VIEWPORT_HEIGHT=2400
# That tall viewport inflates a vh-sized element inside the dialog, leaving a blank band under
# the content; the screenshot is cropped back to what is actually drawn. EGM_SHOT_TRIM=0 keeps
# the full box instead.
# EGM_SHOT_TRIM=0

# Vision-model token cost scales with PIXELS, and the full operation-window capture is tall enough
# to overflow a small model's context on its own ("request (4175 tokens) exceeds the available
# context size (4096)"). The screenshot is downscaled before being sent; the Machine Credit field
# still reads correctly well below the default.
# CHECKCREDIT_VISION_MAX_PX=1280
# CHECKCREDIT_VISION_NUM_CTX=8192      # ask Ollama for more context instead (not always honoured)
# Posted right after the recharge Detail screenshot of /checkcredit, /checkcreditdate and
# /url (/showurl): the screenshot only shows the credit left the cabinet, a human still has
# to clear it and restart the machine. Set empty to post nothing.
# CASHOUT_REBOOT_NOTICE=Kindly manual cashout the credit and reboot the machine Thank you
ALIYUN_ECS_RAM_ROLE_NAME=OSE-ECS-Read-Monitor-sls
ALIYUN_SLS_ASSUME_ROLE_ARN=acs:ram::5754739415144793:role/sls-platform-readonly
AMOUNT_LOSS_SPREADSHEET_TOKEN=<your-value-here>
AMOUNT_LOSS_SHEET_ID=ixOcBO
amountlosssecond=<your-value-here>
FPMS_SPREADSHEET_TOKEN=<your-value-here>
FPMS_SHEET_ID=jYPIOK

# ================= Daily health report (health_report.py + health_checks.py) =================
# One status card a day to the ops group. A restart never re-sends (last slot kept in
# /var/lib/health_report/machine_bot.json, or the gitignored .health_report_state.json next to the
# module when that dir is not writable); a report missed while the bot was down goes out later that day.
# Comments stay on their own lines: systemd's EnvironmentFile keeps a trailing "# ..." in the value.
# HEALTH_REPORT_ENABLE=0 turns it off; HEALTH_REPORT_TIME takes HH:MM, comma-separated for several a day;
# HEALTH_REPORT_TZ takes an IANA name (Asia/Kuala_Lumpur) or an offset (+08:00);
# HEALTH_REPORT_ON_START=1 also sends one ~2 min after boot, at most once per HEALTH_REPORT_ON_START_MIN_HOURS (6).
# Unset: sends only from the systemd service (a PC or shell run stays quiet). 1: from anywhere. 0: never.
# HEALTH_REPORT_ENABLE=
# HEALTH_REPORT_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432
# HEALTH_REPORT_TIME=09:00
# HEALTH_REPORT_TZ=UTC+8
# HEALTH_REPORT_ON_START=0
