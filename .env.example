# ================= OSM Machine List sheet (machineip.py — the primary IP source) =================
# The wiki node behind https://casinoplus.sg.larksuite.com/wiki/NmsFwjzOcibBJckhsqjlRS2kgrb
# ("OSM Machine List"): one tab per venue (CP NCH DYB DHS WF NWR TBR TBP), each with Mini PC /
# Main Encoder / Top Encoder / CCTV columns. /encoder /main /pool /cctv /minipc and a plain
# "@bot NWR2205" read this FIRST; OSM-Watch's IP Audit answers for what it doesn't carry.
# The doc must be shared with THIS bot's app (Sheets + Wiki read), or set MACHINE_IP_APP_ID/
# MACHINE_IP_APP_SECRET to an app that does have access — the same escape hatch MDR uses.
# Defaults work; every line here is optional.
# MACHINE_IP_WIKI_TOKEN=NmsFwjzOcibBJckhsqjlRS2kgrb
# MACHINE_IP_SPREADSHEET_TOKEN=          # pin the sheet directly, skipping wiki resolution
# MACHINE_IP_APP_ID=<app-with-sheet-access>
# MACHINE_IP_APP_SECRET=<your-value-here>
# MACHINE_IP_TTL_SEC=600                 # re-read at most this often (/iprefresh forces one)
# MACHINE_IP_HTTP_TIMEOUT=30             # per-request timeout, seconds
# MACHINE_IP_DATA_FILE=machineiplist.json  # cached copy of the sheet (gitignored)
# MACHINE_IP_SHEET=1                     # 0 = ignore the sheet, OSM-Watch only
# MACHINE_IP_IGNORE_TABS=Template        # tab titles to skip outright
# MACHINE_IP_IGNORE_TAB_MARKERS=(Lab)    # skip any tab whose title contains this

# ================= OSM-Watch (osmwatch.py — /osmwatch /loginosmwatch /encoder) =================
# Defaults work; QR posts to the lab group. Session persisted in osmwatch.json.
# OSMWATCH_WARM=1
# OSMWATCH_QR_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432
# OSMWATCH_ENCODER=1
# OSMWATCH_ENCODER_INTERVAL_SEC=1800
# Machine IPs come from the IP Audit tab of /manage-ip/inventory-sources/ (CMDB
# column), scraped into latestmachineip.json on the same interval as the TRTC
# scrape. Set to 0 to fall back to the IPs on the trtc-details page.
# OSMWATCH_IPAUDIT=1
# OSMWATCH_IPAUDIT_URL=https://osm-watch.cliveslot.com/manage-ip/inventory-sources/
# OSMWATCH_IPAUDIT_API=/manage-ip/inventory-sources/ip-audit/
# OSMWATCH_IPAUDIT_DATA_FILE=latestmachineip.json
# TRTC SDKAppID shown next to every room in /encoder /main /pool /cctv (fixed constant).
# OSMWATCH_ENCODER_APP_ID=20008185
# open_id @tagged on "failed / can access OSM-Watch" alerts. Send /whoami to the bot to
# get your open_id (also printed to the server log on every command), then set it here.
# OSMWATCH_ALERT_TAG_OPEN_ID=ou_xxxxxxxxxxxxxxxx


